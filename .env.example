# Copy to .env (never committed) to use screenshot import in `pnpm dev`
# without typing the key in the app. Only the dev server reads this file;
# `pnpm build` never puts the key into the bundle.

# Claude
ANTHROPIC_API_KEY=

# Or any OpenAI-compatible endpoint (used when ANTHROPIC_API_KEY is empty).
# FFR_AI_MODEL is required for it and must accept images.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# FFR_AI_MODEL=qwen-vl-max
